{
  "name": "nexus-studio-shell",
  "version": "0.3.4",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./host.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "layout",
        "theme",
        "locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  }
}
