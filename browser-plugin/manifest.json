{
  "manifest_version": 3,
  "name": "NexusMCP 网页聊天助手",
  "version": "1.2.0",
  "description": "与 NexusMCP 内置浏览器共用的网页聊天适配器，支持已登录 AI 网站的发送、读取与停止。",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NexusMCP 浏览器助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://chat.qwen.ai/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.ai/*",
        "https://kimi.ai/*"
      ],
      "js": [
        "adapter.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://chat.qwen.ai/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://www.doubao.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*"
  ]
}
